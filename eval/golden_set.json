  "_schema": {
    "version": 1,
    "relevant": "Graded relevance by passage key 'source#chunk_index' (the de-duplication key of KnowledgeSearchService, so a twin copy in a second namespace is the same passage). grade 2 = answers the question, 1 = supports it.",
